# Copie para .env se quiser mudar algum padrão. Nada aqui é obrigatório.

# Porta e endereço. 127.0.0.1 = só este computador acessa (recomendado).
PORT=8787
HOST=127.0.0.1

# Tempo mínimo (ms) que cada estado fica na tela, para dar tempo de o personagem andar.
MIN_DWELL_MS=3500

# Nomes pelos quais a página pode ser aberta além de localhost e IPs (ex.: um proxy ou Tailscale), separados por vírgula.
FLOORWALK_ALLOWED_HOSTS=

# Pasta da senha dos hooks (hook.json). Padrão: ~/.floorwalk
FLOORWALK_HOME=
