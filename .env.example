# Opcional: a tela inicial pede e guarda a chave em data/settings.json.
# Se preferir, deixe as chaves aqui. A chave salva pela tela tem prioridade.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: força um modelo. Sem isto, o servidor escolhe sozinho um que responda na sua conta.
FLOORWALK_MODEL=


# Porta e endereço. 127.0.0.1 = só este computador acessa (recomendado).
PORT=8787
HOST=127.0.0.1

# Tempo mínimo (ms) que cada estado fica na tela, para dar tempo de o personagem andar.
MIN_DWELL_MS=3500

# Pasta onde as entregas da equipe são salvas (um .md por pessoa e um resultado.md por tarefa).
WORKSPACE_DIR=./workspace
