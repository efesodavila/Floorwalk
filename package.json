{
  "name": "floorwalk",
  "version": "0.2.0",
  "description": "See your Claude Code sessions at work in a 3D office: each session is a character that walks to the right desk as it edits, reads, tests and ships.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efesodavila/Floorwalk.git"
  },
  "homepage": "https://github.com/efesodavila/Floorwalk#readme",
  "bugs": {
    "url": "https://github.com/efesodavila/Floorwalk/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node server/start.mjs",
    "test": "node --test",
    "build:single": "node scripts/build-single.mjs",
    "hooks:install": "node scripts/claude-hooks.mjs install",
    "hooks:uninstall": "node scripts/claude-hooks.mjs uninstall",
    "hooks:status": "node scripts/claude-hooks.mjs status"
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
